# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Python Virtual Environments
venv/
.venv/
env/
ENV/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Large Datasets & Trained Model Artifacts (exceed GitHub 100MB file limits)
data/raw/*.csv
data/raw/*.parquet
data/raw/*.zip
data/processed/*.joblib
data/processed/*.pkl
data/processed/*.onnx
!data/raw/.gitkeep
!data/processed/.gitkeep
